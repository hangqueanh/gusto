</style></head><body>
<div id="hd"></div><main id="app"></main><div id="ft"></div><div id="modal"></div><div id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s),esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nm=s=>s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d'),now=()=>new Date().toLocaleString('vi-VN'),fmt=n=>n.toLocaleString('vi-VN')+'đ';
// ===== DỮ LIỆU MẪU (từ Mock_Data.pdf) – chưa phải dữ liệu xác minh =====
const P=[['s01','The Corner','Bình Thạnh','Cà phê',35,60,'Cả ngày','Yên tĩnh, tối giản','Máy lạnh, Ổ cắm, Wi-Fi',1.8,7,4.8,'Yên tĩnh, phù hợp học tập và làm việc. Có nhiều ổ cắm.','☕',0],
['s02','Mơ Café','Phú Nhuận','Cà phê',30,55,'7h sáng - 10h tối','Vintage, nhiều cây xanh','Máy lạnh, Wi-Fi',3.2,12,4.6,'Không gian vintage, nhiều góc chụp ảnh đẹp.','🌿',0],
['s03','Daily Brew','Quận 3','Cà phê',40,70,'Cả ngày','Hiện đại, rộng rãi','Ổ cắm, Wi-Fi',2.5,10,4.7,'Bàn rộng, ánh sáng tốt, phù hợp làm việc nhóm.','💻',0],
['s04','Nhà Có Bếp','Bình Thạnh','Cơm gia đình',45,75,'5h sáng - 11h tối','Ấm cúng','Máy lạnh',2.1,8,4.5,'Cơm ngon, khẩu phần ổn, giá hợp lý.','🍚',1],
['s05','Bếp Nhà Mình','Thủ Đức','Cơm Việt',35,60,'7h sáng - 10h tối','Bình dân, thoải mái','Chỗ để xe',6.5,20,4.3,'Đồ ăn vừa miệng, giá sinh viên.','🥢',0],
['s06','Pasta Mood','Quận 1','Món Âu',100,180,'7h sáng - 12h đêm','Lãng mạn','Máy lạnh',4,15,4.8,'Không gian hẹn hò đẹp, món ăn chất lượng.','🍝',1],
['s07','Lẩu Chạm','Quận 3','Lẩu',120,180,'9h sáng - 10h tối','Nhóm bạn, đông vui','Đặt bàn',2.8,11,4.6,'Phù hợp đi nhóm đông, giá tương đối hợp lý.','🍲',0],
['s08','Tiệm Trà An Nhiên','Phú Nhuận','Trà, bánh',30,65,'9h sáng - 9h tối','Nhẹ nhàng, thư giãn','Wi-Fi, máy lạnh',3.5,13,4.7,'Không gian thư giãn, trà dễ uống, bánh ngon.','🍵',0]].map((a,i)=>{const p={};'id n a t lo hi h sp am d m r c e late'.split(' ').forEach((k,j)=>p[k]=a[j]);p.col=`linear-gradient(135deg,hsl(${i*43} 85% 78%),hsl(${i*43+35} 80% 64%))`;p.b=nm([p.n,p.a,p.t,p.sp,p.am,p.c].join(' '))+(p.late?' khuya':'')+(p.hi<=60?' sinhvien':'');return p});
const PT=[{p:'s01',k:'Premium Partner',o:'Giảm 15% cho thành viên GUSTO'},{p:'s06',k:'Featured Partner',o:'Tặng 01 phần khai vị khi đặt bàn'},{p:'s07',k:'Standard Partner',o:'Giảm 30.000đ cho nhóm đi từ 4 người'},{p:'s08',k:'Standard Partner',o:'Free topping trân châu cho mọi loại trà'}];
const VS=[{id:'v10',n:'Voucher giảm 10.000đ',pts:100},{id:'v25',n:'Voucher giảm 25.000đ',pts:200}];
const seed=()=>({me:null,fav:{},cm:{},lk:{},sv:{},vc:{},lg:{},vw:{},of:[],pend:[],
users:[['u_001','Minh Hoàng','minhhoang@work.com',350],['u_002','Nguyễn Thảo','thaonguyen@gmail.com',240],['u_003','Lê Hùng','hungle@yahoo.com',180],['u_004','Phương Anh','phuonganh@edu.vn',90],['u_005','Tuấn Kiệt','tuankiet@gmail.com',420],['u_006','Bảo Ngọc','baongoc@outlook.com',310]].map(a=>({id:a[0],n:a[1],e:a[2],pw:'123456',pt:a[3]})),
rv:[['r06','u_006','Bảo Ngọc','s07',4.6,35,'Phù hợp đi nhóm đông, giá tương đối hợp lý.'],['r05','u_005','Tuấn Kiệt','s06',4.8,40,'Không gian hẹn hò đẹp, món ăn chất lượng.'],['r04','u_004','Phương Anh','s04',4.5,30,'Cơm ngon, khẩu phần ổn, giá hợp lý.'],['r03','u_001','Minh Hoàng','s03',4.7,40,'Bàn rộng, ánh sáng tốt, phù hợp làm việc nhóm.'],['r02','u_003','Lê Hùng','s02',4.6,35,'Không gian vintage, nhiều góc chụp ảnh đẹp.'],['r01','u_002','Nguyễn Thảo','s01',5,40,'Yên tĩnh, phù hợp học tập và làm việc. Có nhiều ổ cắm.']].map(a=>({id:a[0],u:a[1],n:a[2],p:a[3],s:a[4],pts:a[5],x:a[6],t:0}))});
let D;try{D=JSON.parse(localStorage.getItem('gusto-demo-v1'))}catch(e){}if(!D)D=seed();
const save=()=>{try{localStorage.setItem('gusto-demo-v1',JSON.stringify(D))}catch(e){toast('Không lưu được dữ liệu trên trình duyệt này')}};
const me=()=>D.users.find(u=>u.id===D.me),pl=id=>P.find(p=>p.id===id),cnt=id=>D.rv.filter(r=>r.p===id).length;
const favs=()=>D.fav[D.me]||[],isF=id=>favs().includes(id),offs=id=>[...PT.filter(x=>x.p===id).map(x=>x.o),...D.of.filter(x=>x.p===id).map(x=>x.t)];
const addPts=(uid,n,why)=>{const u=D.users.find(x=>x.id===uid);if(!u)return;u.pt+=n;(D.lg[uid]=D.lg[uid]||[]).unshift([why,n,now()])};
const toast=m=>{const t=$('#toast');t.textContent=m;t.className='s';clearTimeout(toast.i);toast.i=setTimeout(()=>t.className='',2600)};
const stars=s=>'★'.repeat(Math.round(s))+'☆'.repeat(5-Math.round(s));
// ===== PHÂN TÍCH YÊU CẦU (rule-based, KHÔNG phải AI thật) =====
const AR=[['Bình Thạnh',/binh thanh/],['Phú Nhuận',/phu nhuan/],['Quận 3',/quan 3\b|\bq\.? ?3\b/],['Quận 1',/quan 1\b|\bq\.? ?1\b/],['Thủ Đức',/thu duc|dai hoc quoc gia|dhqg|linh trung/]];
const TY=[['Cà phê',/ca phe|cafe|coffee/,/Cà phê/],['Lẩu',/\blau\b/,/Lẩu/],['Cơm',/\bcom\b/,/Cơm/],['Trà & bánh',/\btra\b|banh/,/Trà/],['Món Âu',/mon au|pasta|\bau\b/,/Âu/]];
const FT=[['yên tĩnh',/yen tinh/,/yen tinh/],['ổ cắm điện',/o cam|sac/,/o cam/],['Wi-Fi',/wi-?fi/,/wi-?fi/],['máy lạnh',/may lanh|dieu hoa/,/may lanh/],['học tập/làm việc',/hoc bai|hoc tap|lam viec|study/,/hoc tap|lam viec/],['hẹn hò/lãng mạn',/hen ho|lang man|cap doi/,/hen ho|lang man/],['nhóm bạn',/nhom|ban be|tu tap/,/nhom|dong vui|dat ban/],['chụp ảnh/vintage',/chup anh|song ao|check-?in|vintage/,/chup anh|vintage/],['ăn khuya',/khuya|dem/,/khuya/],['giá sinh viên',/sinh vien|hoc sinh|gia re/,/sinhvien/]];
function parse(q){const s=nm(q),c={area:null,type:null,bud:null,ft:[]};if(!s.trim())return c;
 const a=AR.find(x=>x[1].test(s));if(a)c.area=a[0];const t=TY.find(x=>x[1].test(s));if(t)c.type=t;
 const m=s.replace(/(\d)[.,](\d{3})/g,'$1$2').match(/(\d{2,6})\s*(k|nghin|ngan|d|dong)?\b/);if(m){const v=+m[1];c.bud=v>=1000?v/1000:v}
 c.ft=FT.filter(f=>f[1].test(s));return c}
function evalP(p,c){const ok=[],no=[];let hard=0,hOk=0;
 if(c.area){hard++;(p.a===c.area?(hOk++,ok):no).push('khu vực '+c.area+(p.a===c.area?'':' (quán ở '+p.a+')'))}
 if(c.type){hard++;(c.type[2].test(p.t)?(hOk++,ok):no).push('loại hình '+c.type[0]+(c.type[2].test(p.t)?'':' (quán là '+p.t+')'))}
 if(c.bud){hard++;const g=p.lo<=c.bud;(g?(hOk++,ok):no).push('giá từ '+p.lo+'k'+(g?' ≤ ':' > ')+c.bud+'k')}
 let fOk=0;c.ft.forEach(f=>{if(f[2].test(p.b)){fOk++;ok.push(f[0])}else no.push(f[0]+' (chưa có trong dữ liệu)')});
 const tot=hard+c.ft.length;return{p,ok,no,pass:hOk===hard,pct:tot?Math.round((hOk+fOk)/tot*100):0,sc:hOk*3+fOk*2+p.r/5}}
const whyH=e=>`${e.ok.length?`<span class="ok">✓ ${e.ok.map(esc).join(' · ✓ ')}</span>`:''}${e.no.length?`<br><span class="no">✗ ${e.no.map(esc).join(' · ✗ ')}</span>`:''}`;
// ===== BỘ LỌC =====
const FO={area:['Quận 1','Quận 3','Bình Thạnh','Phú Nhuận','Thủ Đức'],price:['Dưới 50.000đ','50.000–100.000đ','100.000–200.000đ','Trên 200.000đ'],type:['Cà phê','Cơm','Món Âu','Lẩu','Trà'],style:['Vintage','Hiện đại','Tối giản','Ấm cúng','Lãng mạn','Bình dân'],space:['Yên tĩnh','Máy lạnh','Ổ cắm','Wi-Fi','Phù hợp học tập'],aud:['Đi một mình','Nhóm bạn','Gia đình','Cặp đôi'],rate:['Từ 3 sao','Từ 4 sao','Từ 5 sao'],sort:['Phù hợp nhất','Đánh giá cao','Giá thấp','Gần nhất']};
const FL={area:'Vị trí',price:'Khoảng giá',type:'Loại hình',style:'Phong cách',space:'Không gian',aud:'Đối tượng',rate:'Đánh giá',sort:'Sắp xếp'};
const PR=[[0,50],[50,100],[100,200],[200,1e9]],SPR=[/yen tinh/,/may lanh/,/o cam/,/wi-?fi/,/hoc tap|lam viec/],AUD=[/yen tinh|hoc tap|lam viec/,/nhom|dong vui/,/gia dinh|am cung/,/hen ho|lang man/];
const idx=(k,v)=>FO[k].indexOf(v);
function filt(p){const g=k=>F[k];if(g('area')&&p.a!==g('area'))return 0;if(g('price')){const r=PR[idx('price',g('price'))];if(p.hi<r[0]||p.lo>r[1])return 0}
 if(g('type')&&!p.t.includes(g('type')))return 0;if(g('style')&&!p.sp.includes(g('style')))return 0;
 if(g('space')&&!SPR[idx('space',g('space'))].test(p.b))return 0;if(g('aud')&&!AUD[idx('aud',g('aud'))].test(p.b))return 0;
 if(g('rate')&&p.r<3+idx('rate',g('rate')))return 0;return 1}
let S={q:'',star:5,img:''},F={},M=null;
// ===== GIAO DIỆN =====
