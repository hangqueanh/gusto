logout:()=>{D.me=null;save();go('home');render()},
fav:t=>{if(!need())return;const a=D.fav[D.me]=D.fav[D.me]||[],i=t.dataset.i,k=a.indexOf(i);k<0?a.push(i):a.splice(k,1);save();render();toast(k<0?'Đã lưu yêu thích':'Đã bỏ lưu')},
like:t=>{if(!need())return;const id=t.dataset.i,a=D.lk[id]=D.lk[id]||[],k=a.indexOf(D.me);k<0?a.push(D.me):a.splice(k,1);const r=D.rv.find(x=>x.id===id);
 if(a.filter(x=>x!==r.u).length>=3&&!r.bonus&&r.t){r.bonus=1;addPts(r.u,5,'Review được cộng đồng yêu thích')}save();render()},
sv:t=>{if(!need())return;const a=D.sv[D.me]=D.sv[D.me]||[],i=t.dataset.i,k=a.indexOf(i);k<0?a.push(i):a.splice(k,1);save();render()},
cm:t=>{if(!need())return;const i=t.dataset.i,el=$('#c-'+i),x=el.value.trim();if(!x)return;(D.cm[i]=D.cm[i]||[]).push({n:me().n,x});save();render()},
wr:t=>{S.rp=t.dataset.i},
post:()=>{if(!need())return;const x=$('#rt').value.trim(),u=me();if(x.length<20)return toast('Nhận xét cần ít nhất 20 ký tự');
 const id='r'+Date.now(),img=S.img,pts=20+(img?10:0)+(x.length>=80?10:0);D.rv.unshift({id,u:u.id,n:u.n,p:$('#rp').value,s:+$('#rs').value,x,img,t:now(),pts});
 addPts(u.id,20,'Đăng review hợp lệ');if(img)addPts(u.id,10,'Đính kèm hình ảnh thực tế');if(x.length>=80)addPts(u.id,10,'Review có nội dung chi tiết');S.img='';save();render();toast('Đã đăng bài, +'+pts+' điểm')},
redeem:t=>{if(!need())return;const v=VS.find(x=>x.id===t.dataset.i);if(me().pt<v.pts)return toast('Chưa đủ điểm: cần '+v.pts+', bạn có '+me().pt);M={v};render()},
ok:()=>{const u=me(),v=M.v;if(u.pt<v.pts){M=null;render();return toast('Không đủ điểm')}addPts(u.id,-v.pts,'Đổi '+v.n);(D.vc[u.id]=D.vc[u.id]||[]).unshift({n:v.n,c:'GUSTO-'+Math.random().toString(36).slice(2,8).toUpperCase(),t:now()});M=null;save();render();toast('Đổi thành công, xem trong hồ sơ')},
claim:t=>{if(!need())return;const x=PT.find(y=>y.p===t.dataset.i);(D.vc[D.me]=D.vc[D.me]||[]).unshift({n:pl(x.p).n+': '+x.o,c:'GUSTO-'+Math.random().toString(36).slice(2,8).toUpperCase(),t:now()});save();toast('Đã lưu ưu đãi vào hồ sơ')},
preg:()=>{const n=$('#pn').value.trim();if(!n||!$('#pe').value.includes('@'))return toast('Nhập tên quán và email hợp lệ');D.pend.push({n,a:$('#pa').value,t:$('#pt').value,d:$('#pd').value,e:$('#pe').value});save();render();toast('Đã gửi đăng ký, chờ xác minh')},
offer:()=>{const t=$('#ot').value.trim();if(!t)return toast('Nhập nội dung ưu đãi');D.of.push({p:$('#oq').value,t});save();render();toast('Đã phát hành ưu đãi')}};
document.addEventListener('click',e=>{const t=e.target.closest('[data-a]');if(!t)return;if(t.dataset.a==='close'&&e.target!==t)return;if(t.tagName==='A'&&t.dataset.a==='wr'){A.wr(t);return}A[t.dataset.a]&&A[t.dataset.a](t)});
document.addEventListener('keydown',e=>{if(e.key!=='Enter')return;const t=e.target;if(t.dataset&&t.dataset.e){e.preventDefault();if(t.dataset.e==='hs'){S.q=t.value;go('search');render()}else A[t.dataset.e](t)}});
document.addEventListener('change',e=>{const t=e.target;if(t.dataset.f){F[t.dataset.f]=t.value;render()}if(t.id==='ri'&&t.files[0]){const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const s=Math.min(1,520/im.width),c=document.createElement('canvas');c.width=im.width*s;c.height=im.height*s;c.getContext('2d').drawImage(im,0,0,c.width,c.height);S.img=c.toDataURL('image/jpeg',.7);toast('Đã đính kèm ảnh')};im.src=r.result};r.readAsDataURL(t.files[0])}});
addEventListener('hashchange',()=>{render();scrollTo(0,0)});render();
</script></body></html>
